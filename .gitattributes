# 统一行尾：仓库内存 LF，避免 Windows / Unix 协作者出现整文件 diff
* text=auto eol=lf

# 明确按文本处理（可 diff、可合并）
*.rs text
*.ts text
*.tsx text
*.js text
*.json text
*.css text
*.html text
*.md text
*.yml text
*.yaml text
*.toml text
*.sh text eol=lf

# 二进制资源：不做行尾转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.db binary
*.svg text
