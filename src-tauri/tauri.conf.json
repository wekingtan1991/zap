{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "zap",
  "version": "0.12.0",
  "identifier": "com.ais.zap",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "zap",
        "width": 720,
        "height": 480,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": true
      },
      {
        "label": "superpanel",
        "title": "zap-actions",
        "width": 264,
        "height": 240,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": true,
        "focus": false
      },
      {
        "label": "stagedrop",
        "title": "zap-stagedrop",
        "width": 280,
        "height": 44,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "focusable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM5NTc4OTdFRDE2NDI3MTUKUldRVkoyVFJmb2xYeWFVRlhocXBmSmg5SHRMdEJ0UEkxWnlyc09pcW8zdHNBT0VpVC9EU09TSkcK",
      "endpoints": [
        "https://github.com/wekingtan1991/zap/releases/latest/download/latest.json"
      ]
    }
  }
}
